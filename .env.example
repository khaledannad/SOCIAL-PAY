# =========================================================================
# SOCIAL PAY CORE — ENVIRONMENT CONFIGURATION (.env.example)
# =========================================================================

# GEMINI_API_KEY: Required for dialect AI assistant & OCR smart scanning.
# Configured via the Secrets panel in Google AI Studio.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Protocol & Base Configuration
SOCIAL_PAY_BASE_URL=https://pay.socialpay.io
SOCIAL_PAY_PROTOCOL_FEE_USD=0.80
SOCIAL_PAY_PROTOCOL_FEE_TIER2_USD=0.90
SOCIAL_PAY_VOLUME_THRESHOLD_USD=1000000.0

# Security & Webhook Signatures
# Webhook HMAC-SHA256 Secret Key for verifying inbound provider callbacks
SOCIAL_PAY_WEBHOOK_SECRET=whsec_socialpay_sandbox_key_2026_demo

# Open Banking & Payment Gateway Credentials (Sandbox / Production)
# Saudi Sarie / UAE FTS / Open Banking API Client
OPEN_BANKING_CLIENT_ID=sbx_client_sarie_882910
OPEN_BANKING_CLIENT_SECRET=sbx_secret_sarie_live_test
OPEN_BANKING_SANDBOX_MODE=true

# Card & Gateway Sandbox (3D Secure)
SANDBOX_GATEWAY_API_KEY=sbx_gw_key_live_testing_sandbox
SANDBOX_GATEWAY_WEBHOOK_SECRET=whsec_card_gw_hmac_256

# Non-Custodial Blockchain RPC Nodes (Monitoring and Escrow Verification Only - No Private Keys)
TRON_RPC_URL=https://api.trongrid.io
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_project_id
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BITCOIN_MEMPOOL_URL=https://mempool.space/api

# Anti-Phishing & Anti-Fraud Config
ANTI_PHISHING_DEFAULT_WATERMARK=درع_الأمان_الخالد_2026
MAX_DAILY_UNVERIFIED_LIMIT_USD=100.0
MAX_DAILY_TIER1_LIMIT_USD=1000.0
MAX_DAILY_TIER2_LIMIT_USD=15000.0
